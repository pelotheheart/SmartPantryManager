<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/rowContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:id="@+id/ingredIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/shopping_bag_small" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/listItem_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pantry Item"
                android:textColor="#020202"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/listitem_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantity" />

            <TextView
                android:id="@+id/listItem_xdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry Date" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:background="#999999"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
